{
  "meta": {
    "name": "concept-collision-probe",
    "description": "The §D13 gate. The primitive table maps 28 letters onto 18 profiles, so ten letters have no profile of their own. This file fixes the test's denominator BEFORE its numerator: the qualification block is committed before a single concept is composed, and the probe block is written only afterwards.",
    "ordering_is_the_protocol": [
      "`qualification` is committed first, alone, with `probe` absent.",
      "`probe` is written by scripts/run_collision_probe.py, which refuses to run unless `qualification` is already present, and records the sha256 of the qualification block it ran against.",
      "Discovering afterwards that a class held one usable comparison, or none, would make the real size of the test unstatable in good faith."
    ],
    "sample_is_not_revised": "The probe roots are not changed once this table is published. Cleaner single-aṣl alternates exist — بدل/جدل for ب/ج/د, ستر/سكر for ت/ك — and are REJECTED: swapping a sample because the aṣl turned out awkward is choosing roots by looking at the data, the one move the whole protocol exists to prevent."
  },
  "criterion": {
    "compared_on": "realised primitives — never sentences",
    "outcomes": {
      "identical": "the same multiset of realised primitives, at the same positions, in the same order",
      "order-distinct": "the same primitives, at different positions or in a different order",
      "distinct": "different realised primitives"
    },
    "order_distinct_is_a_partial_collision": "It is counted and reported as one, never grouped with `distinct` and never filed as a pass: two concepts built from one set of primitives shuffled are separated by the composition rule alone, not by anything the table knows about their letters.",
    "asl_divergence_rule": "A pair counts as aṣl-divergent only when NO aṣl of one root matches ANY aṣl of the other. Comparing whole sets rather than a chosen primary makes divergence harder to establish, so the rule cannot inflate a collision verdict."
  },
  "size": {
    "roots": 7,
    "classes": 3,
    "per_class_roots": {
      "ب/ج/د": 3,
      "ت/ك": 2,
      "و/ي": 2
    },
    "stated_as": "7 roots over 3 classes (3 + 2 + 2)",
    "never_stated_as": "5 pairs — the three ب/ج/د comparisons share their roots and are correlated; counting them as independent tests would inflate the probe's own n by counting the same evidence more than once.",
    "fragility": "Two of the three classes rest on a single comparison each, so a non-qualifying verdict empties them immediately. Stated here rather than discovered at the table."
  },
  "decision_rules_fixed_in_advance": {
    "one_identical_ends_it": "A single `identical` on an aṣl-divergent pair confirms the collision: stop, do not widen, and mapping the five classical مخرج zones becomes v1.0.0 of the table rather than a later lock bump. Tasks 1–3 are redone before anything else proceeds.",
    "emptied_secondary_class": "ت/ك or و/ي empty ⇒ run on what qualifies and report the reduced size. No root is added to compensate.",
    "emptied_carrying_class": "ب/ج/د empty ⇒ the probe cannot decide: stop and report. Alternates are examined only after that report, and the report must say the substitution followed an EMPTY SAMPLE — not the same thing as choosing after seeing a result, and the reader is owed the distinction rather than asked to trust it.",
    "widening": "Only a clean sweep — all three classes `distinct` on aṣl-divergent pairs — licenses extending to ط/ق, ث/ح/ف/ه and م/ن.",
    "excluded_in_every_case": {
      "class": "ظ/غ",
      "why": "Its only real minimal pair is ظلم/غلم, and ظلم is one of the five roots already curated in root_cores.json — contaminated, and therefore useless as evidence in either direction."
    },
    "withdrawn": {
      "pair": [
        "روح",
        "ريح"
      ],
      "why": "ريح is not a QAC root key — it is a derivative of ر-و-ح — so the pair had nothing to compare."
    }
  },
