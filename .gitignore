# Python
__pycache__/
*.py[cod]
.venv*/
*.egg-info/
.pytest_cache/

# Environment
.env
# Backups of .env carry the same secrets as .env itself (API keys, hosts).
.env.bak
.env.*.bak
.env.local

# Local Claude Code config
.claude/

# Data buckets that are not committed. The rule is now the layout itself:
# `derived/` is whatever a script can rebuild, `runtime/` is mutable state the
# running app owns, and `source/maqayis/` is the one documented departure from
# its bucket — a large re-downloadable original (build_maqayis_dataset.py
# --fetch) whose curated derivative `data/references/maqayis_asl.csv` is what
# the repo actually ships.
data/derived/
data/runtime/
data/source/maqayis/

# Local dev runtime logs
local-dev/logs/

# OS
.DS_Store

# Node / frontend
node_modules/
.next/

# Not published — local-only scaffolding used to build / test / validate / plan.
# Kept on disk for development; excluded from the public product repo.
plans/
tests/
local-dev/
.github/workflows/
CLAUDE.md
architecture.md
project_summary.md
pytest.ini
requirements-test.txt
frontend/vitest.config.ts
frontend/vitest.setup.ts
frontend/tsconfig.test.json
*.test.ts
*.test.tsx

# Root-source evaluation workbench. Deleted in the repo restructure: the
# cross-source investigation it served concluded (QAC alone suffices; no
# majority vote), and it was 1.2 GB of downloaded sources, scratch dumps and a
# vendored venv. Its product, data/references/root_arbitration.json, IS
# committed and unaffected. The rule stays so a re-created workbench is ignored
# by default rather than by accident.
eval/
