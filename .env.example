# ── LLM ─────────────────────────────────────────────────────
LLM_PROVIDER=ollama                 # "ollama" | "anthropic"
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b             # default; 72b needs a large GPU/RAM
# How long Ollama keeps the model resident after a request. This is a
# memory dial as much as a latency one: the loaded model is ~4.7 GB that a
# unified-memory Mac cannot compress or swap (it is wired GPU memory). On a
# 16 GB machine, a long keep_alive means one chat message starves every
# other component for that whole window. Raise it only if you have headroom.
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_PREDICT=512            # cap output tokens per generation
OLLAMA_NUM_CTX=4096              # context window (tokens)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Vector DB (Qdrant) ──────────────────────────────────────
# When running locally outside Docker, use http://localhost:6333
# Qdrant location. Set QDRANT_PATH to run it EMBEDDED in the backend process
# (no server, no Docker) — the corpus is 6236 vectors (~24 MB), far below
# anything needing a server, and on a small machine the Docker Desktop VM
# costs far more RAM than the data. Embedded mode takes an exclusive file
# lock, so build_index.py and the API cannot run at the same time.
# Leave QDRANT_PATH empty to use the server at QDRANT_URL instead.
# An explicit url= passed in code always wins over QDRANT_PATH.
QDRANT_PATH=
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=quran_verses

# ── Embedding ───────────────────────────────────────────────
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
# Lightweight fallback (768 dims) if RAM is insufficient:
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DEVICE=auto               # "auto" | "cpu" | "cuda" | "mps"
EMBEDDING_BATCH_SIZE=32

# ── Retrieval quality (Step 8 / phase 2) ────────────────────
# QueryProcessor: language/filters/Arabic-root expansion of the retrieval
# query. Cheap and deterministic (no LLM) — on by default.
QUERY_PROCESSOR_ENABLED=1
# Root-aware retrieval: adds a 3rd RRF channel ranking verses by shared Arabic
# root (IDF-weighted coverage). Cheap (no ML, dict lookups). Serves تفسير القرآن
# بالقرآن; improves every eval metric (see tests/eval/EVAL_REPORT.md). ON by
# default (cheap + strictly positive); set to 0 to disable.
ROOT_CHANNEL_ENABLED=1
# HyDE: generate a hypothetical verse to enrich the retrieval query. Adds one
# LLM call per question (latency) — off by default.
HYDE_ENABLED=0
# Multilingual cross-encoder reranking (ar/fr/en). ~2.3 GB; off by default.
RERANK_ENABLED=0
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Rerank GET /search ("Similar Verses" tab) only — reorders a wider fused
# candidate pool by query↔verse relevance, demoting dense-branch noise
# (basmala/short openers). Uses RERANK_MODEL (~2.3 GB). Off by default.
# 1 = the /search cross-encoder (~1.1 GB) is ALLOWED to load. It is built on
# the first similar-verse search that needs it, never at startup.
SEARCH_RERANK_ENABLED=0

# ── App ─────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
